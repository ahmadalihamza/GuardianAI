# GuardianAI frontend configuration
# Copy this file to .env.local

# Base URL of the FastAPI backend. Only the Next.js *server* uses this value,
# so the backend does not need to be reachable from the browser.
BACKEND_URL=http://localhost:8000

# How long /api/analyze waits for upload + analysis before giving up, in
# milliseconds. Raise this for long clips on slow hardware. Default: 15 minutes.
ANALYZE_TIMEOUT_MS=900000
