# Server-side FastAPI base URL. Never expose this as NEXT_PUBLIC_*.
BACKEND_URL=http://127.0.0.1:8000

# This covers upload + job creation only. Video processing runs asynchronously
# and the browser polls for real frame progress.
ANALYZE_SUBMIT_TIMEOUT_MS=120000

# Keep this aligned with MAX_UPLOAD_MB on the backend service.
MAX_UPLOAD_MB=50
