# Environment Configuration for GuardianAI
# Copy this file to .env and fill in your values

# Optional: DashScope API key for Qwen AI summaries
# Leave blank to use deterministic template summaries
DASHSCOPE_API_KEY=

# YOLO model path (downloads automatically if not present)
YOLO_MODEL_PATH=yolo11n.pt

# Database path
DATABASE_PATH=data/guardianai.db

# Processing settings
# On Render, unset values automatically fall back to 5 / 640 to suit the free
# 0.1-CPU instance. Explicit values here are the higher-quality local defaults.
PROCESS_EVERY_N_FRAMES=2
MAX_FRAME_WIDTH=960
MAX_UPLOAD_MB=50
ANALYSIS_JOB_TTL_SECONDS=3600

# Incident detection settings
INCIDENT_COOLDOWN_SECONDS=8
ZONE_PERSISTENCE_FRAMES=10
FALL_PERSISTENCE_FRAMES=6

# Fall detection thresholds
FALL_RATIO_THRESHOLD=1.4
FALL_VERTICAL_SPEED_THRESHOLD=0.02
FALL_MIN_HEIGHT_DROP=0.08

# --- Accuracy hardening -------------------------------------------------------
# A brand-new track has an unstable box and an unreliable class. Requiring a few
# confirmed observations first removes most single-frame false positives, at the
# cost of a fraction of a second of latency.
MIN_TRACK_AGE_FRAMES=3
# Rolling window (in processed observations) for the confidence reported on an
# incident. Instantaneous confidence is noisy frame to frame.
CONFIDENCE_SMOOTHING_WINDOW=8

# --- Optional custom checkpoints ----------------------------------------------
# COCO has no fire, smoke or firearm class, so fire and weapon detection are
# heuristic by default. Point either of these at your own fine-tuned weights to
# replace the corresponding heuristic with a trained model. Paths are resolved
# relative to the repo root or to models/. Left blank = heuristic mode.
FIRE_MODEL_PATH=
WEAPON_MODEL_PATH=

# --- Fire / smoke detection ---------------------------------------------------
FIRE_PERSISTENCE_FRAMES=8
# Minimum share of the frame that must look like flame before it counts.
FIRE_MIN_AREA_RATIO=0.004
# Flames flicker; a traffic cone or a hi-vis jacket does not. Minimum temporal
# variance score required to accept a flame-coloured region.
FIRE_MIN_FLICKER_SCORE=0.12
SMOKE_PERSISTENCE_FRAMES=12
SMOKE_MIN_AREA_RATIO=0.020
# Set to false if grey haze, dust or fog in your scene causes nuisance alerts.
ENABLE_SMOKE_DETECTION=true

# --- Weapon detection ---------------------------------------------------------
WEAPON_CONFIDENCE_THRESHOLD=0.35
WEAPON_PERSISTENCE_FRAMES=3
# How close (as a multiple of the person's box width) a weapon must be to a
# person before the incident escalates from "Weapon Detected" to "Armed Person".
WEAPON_PERSON_PROXIMITY=0.6

# --- Traffic accident detection -----------------------------------------------
# Speeds are in box-widths per second, so thresholds hold at any camera
# distance without retuning.
ACCIDENT_MIN_SPEED=0.35
# Fractional speed loss within the window below that flags a hard stop.
ACCIDENT_DECEL_RATIO=0.65
ACCIDENT_DECEL_WINDOW_SECONDS=0.6
# Box overlap (IoU) between two vehicles that counts as contact.
ACCIDENT_CONTACT_IOU=0.15
ACCIDENT_PERSISTENCE_FRAMES=3
# Relative aspect-ratio change that suggests a vehicle has overturned.
ACCIDENT_OVERTURN_RATIO_DELTA=0.45

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# The Next.js dashboard is configured separately — see
# frontend/.env.local.example (BACKEND_URL, ANALYZE_TIMEOUT_MS).
